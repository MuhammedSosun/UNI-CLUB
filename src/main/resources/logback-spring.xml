<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- ========== Genel Ayarlar ========== -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="uniClub"/>
    <property name="LOG_PATH" value="logs"/>
    <property name="LOGSTASH_HOST" value="logstash"/>
    <property name="LOGSTASH_PORT" value="5000"/>

    <!-- ========== Console Log (Geliştirme Ortamı) ========== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS}
                [trace:%X{trace_id}]
                [user:%X{username}]
                [role:%X{role}]
                [op:%X{operation}]
                %-5level %logger{36} - %msg%n
            </pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

